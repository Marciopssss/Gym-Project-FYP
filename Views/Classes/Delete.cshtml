@model Gym_Membership.Models.Classes
@{
    ViewData["Title"] = "Delete Class";
}

<h2 class="text-danger mb-3">Delete Class</h2>

<div class="alert alert-warning">
    <h5>Are you sure you want to delete this class?</h5>
</div>

<div class="card bg-dark border-secondary p-3">
    <p><strong>Class Name:</strong> @Model.ClassName</p>
    <p><strong>Trainer:</strong> @Model.TrainerName</p>
    <p><strong>Schedule:</strong> @Model.ScheduleTime</p>
    <p><strong>Duration:</strong> @Model.Duration minutes</p>
</div>

<form asp-action="Delete" method="post">
    <!-- <-- here -->
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ClassID" />
    <div class="d-flex justify-content-between mt-3">
        <button type="submit" class="btn btn-danger w-50 me-2">Delete</button>
        <a asp-action="Index" class="btn btn-secondary w-50">Cancel</a>
    </div>
</form>
