@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model IEnumerable<Gym_Membership.Models.Classes>

@{
    ViewData["Title"] = "Browse Classes";
    var username = HttpContextAccessor.HttpContext.Session.GetString("Username");

    // Default class images
    string GetDefaultImage(string type)
    {
        return type?.ToLower() switch
        {
            "yoga" => "/images/classes/yoga.jpg",
            "cardio" => "/images/classes/cardio.jpg",
            "strength" => "/images/classes/strength.jpg",
            "pilates" => "/images/classes/pilates.jpg",
            "boxing" => "/images/classes/boxing.jpg",
            _ => "/images/classes/default.jpg"
        };
    }
}

<section class="py-5 bg-dark text-light">
    <div class="container">
        <h2 class="fw-bold mb-4 text-info text-center text-uppercase">Explore Our Classes</h2>

        @if (!Model.Any())
        {
            <div class="text-center text-secondary mt-5">
                <h5>No classes available yet. Please check back soon!</h5>
            </div>
        }
        else
        {
            <div class="row g-4 justify-content-center">
                @foreach (var c in Model)
                {
                    var imageUrl = !string.IsNullOrWhiteSpace(c.ImagePath) ? c.ImagePath : GetDefaultImage(c.ClassName);

                    <div class="col-md-4 col-lg-3">
                        <div class="card shadow-lg bg-dark text-light h-100 border-0 rounded-4 overflow-hidden hover-zoom">
                            <img src="@imageUrl"
                                 alt="@c.ClassName"
                                 class="card-img-top"
                                 style="height: 220px; object-fit: cover; filter: brightness(0.9);" />

                            <div class="card-body text-center p-4">
                                <h4 class="fw-bold text-uppercase text-info">@c.ClassName</h4>
                                <p class="text-muted small mb-3">@c.Description</p>
                                <h6 class="text-light mb-3">@c.ScheduleTime.ToString("dddd, h:mm tt")</h6>

                                @if (username != null)
                                {
                                    <form method="post" asp-action="Subscribe" asp-route-id="@c.ClassID">
                                        <button type="submit" class="btn btn-neon-primary px-4">Subscribe</button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-outline-neon px-4"
                                            data-bs-toggle="modal" data-bs-target="#loginPromptModal">
                                        Subscribe
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- 🔒 LOGIN PROMPT -->
<div class="modal fade" id="loginPromptModal" tabindex="-1" aria-labelledby="loginPromptLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border border-info shadow-lg">
            <div class="modal-header border-0">
                <h5 class="modal-title text-info fw-bold" id="loginPromptLabel">Login Required</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <p class="mb-4 fs-5">You need to log in or sign up to subscribe to a class.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-info px-4">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Log In
                    </a>
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-info px-4">
                        <i class="bi bi-person-plus me-2"></i> Sign Up
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-zoom img {
        transition: transform 0.5s ease, filter 0.4s ease;
    }

    .hover-zoom:hover img {
        transform: scale(1.05);
        filter: brightness(1.1);
    }

    .card:hover {
        box-shadow: 0 0 25px rgba(0, 255, 255, 0.15);
        transform: translateY(-6px);
        transition: all 0.3s ease;
    }
</style>
