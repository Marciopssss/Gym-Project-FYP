@model IEnumerable<Gym_Membership.Models.Classes>

@{
    ViewData["Title"] = "Browse Classes";
}

<div class="container mt-5">
    <h2 class="text-center fw-bold text-info mb-4">
        <i class="bi bi-calendar2-check"></i> Browse Available Classes
    </h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning text-center">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center">@TempData["Success"]</div>
    }

    <div class="row g-4">
        @foreach (var c in Model)
        {
            <div class="col-md-4">
                <div class="card bg-dark text-light border border-info shadow-lg h-100">
                    <img src="~/images/classes/@(c.ImagePath ?? "default-class.jpg")"
                         class="card-img-top rounded-top"
                         style="height: 220px; object-fit: cover;" alt="@c.ClassName" />

                    <div class="card-body text-center">
                        <h5 class="fw-bold text-info mb-1">@c.ClassName</h5>
                        <p class="text-secondary small mb-1">Trainer: @c.TrainerName</p>
                        <p class="text-muted mb-2">
                            <i class="bi bi-clock"></i>
                            @c.ScheduleTime.ToString("MMM dd, yyyy hh:mm tt")
                        </p>
                        <p class="text-muted">Duration: @c.Duration min</p>
                        <p class="text-info fw-semibold mb-2">
                            <i class="bi bi-cash-stack"></i> $@c.PricePerSession per session
                        </p>


                        <form asp-action="SubscribeWithStripe" method="post">
                            <input type="hidden" name="classId" value="@c.ClassID" />
                            <button type="submit" class="btn btn-neon-primary w-100 mt-2">
                                <i class="bi bi-credit-card"></i> Pay & Subscribe
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        }
    </div>
</div>
