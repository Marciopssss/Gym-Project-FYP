@{ ViewData["Title"] = "Login"; }
<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card p-4 card-glow">
      <h3 class="mb-3">Welcome back</h3>
      <form>
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" class="form-control" placeholder="you@example.com">
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input type="password" class="form-control" placeholder="••••••••">
        </div>
        <button class="btn btn-primary w-100">Login</button>
        <div class="text-center mt-3 text-secondary">or</div>
        <a class="btn btn-outline-light w-100 mt-2 d-flex align-items-center justify-content-center gap-2" href="#">
          <img src="https://www.svgrepo.com/show/475656/google-color.svg" width="20" height="20" alt="">
          Continue with Google
        </a>
      </form>
    </div>
  </div>
</div>
