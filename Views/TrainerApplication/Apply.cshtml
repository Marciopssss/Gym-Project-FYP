@model Gym_Membership.Models.TrainerApplication
@{
    ViewData["Title"] = "Become a Personal Trainer";
}

<div class="container py-5 text-light">
    <h2 class="fw-bold text-info mb-4 text-center">Apply to Become a Personal Trainer 🏋️</h2>
    <p class="text-secondary text-center mb-5">
        Share your fitness experience and certifications to join our professional team.
    </p>

    <form asp-action="Apply" enctype="multipart/form-data" method="post" class="mx-auto" style="max-width: 600px;">
        <div class="mb-3">
            <label asp-for="Username" class="form-label text-info">Full Name</label>
            <input asp-for="Username" class="form-control bg-dark text-light border-secondary" required />
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label text-info">Email</label>
            <input asp-for="Email" class="form-control bg-dark text-light border-secondary" type="email" required />
        </div>

        <div class="mb-3">
            <label asp-for="Experience" class="form-label text-info">Experience & Background</label>
            <textarea asp-for="Experience" class="form-control bg-dark text-light border-secondary" rows="4" required></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label text-info">Upload Certificate (optional)</label>
            <input type="file" name="CertificateFile" class="form-control bg-dark text-light border-secondary" />
        </div>

        <div class="mb-3">
            <label asp-for="AdditionalInfo" class="form-label text-info">Additional Information</label>
            <textarea asp-for="AdditionalInfo" class="form-control bg-dark text-light border-secondary" rows="3"></textarea>
        </div>

        <button type="submit" class="btn btn-info w-100 py-2 fw-semibold shadow-sm">Submit Application</button>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mt-3">@TempData["Success"]</div>
        }
    </form>
</div>
