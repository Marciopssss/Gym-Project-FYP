@model List<Gym_Membership.Models.Classes>

@{
    ViewData["Title"] = "My Enrolled Classes";
}

<div class="container mt-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center shadow-sm rounded-4 p-3 mb-4">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        </div>
    }

    <h2 class="fw-bold text-center mb-4 text-info">
        <i class="bi bi-calendar-check"></i> My Enrolled Classes
    </h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center p-4 shadow-sm rounded-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            You haven’t enrolled in any classes yet.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var c in Model)
            {
                <div class="col-md-4">
                    <div class="card bg-dark text-light border border-secondary shadow-lg h-100">
                        @if (!string.IsNullOrEmpty(c.ImagePath))
                        {
                            <img src="@c.ImagePath" class="card-img-top" alt="@c.ClassName"
                                 style="height: 200px; object-fit: cover;">
                        }
                        <div class="card-body text-center">
                            <h5 class="card-title text-info fw-bold">@c.ClassName</h5>
                            <p class="text-muted mb-1"><i class="bi bi-person-fill"></i> Trainer: @c.TrainerName</p>
                            <p class="text-muted mb-1"><i class="bi bi-clock"></i> @c.ScheduleTime.ToString("MMMM dd, yyyy - hh:mm tt")</p>
                            <p class="text-muted mb-1"><i class="bi bi-hourglass-split"></i> Duration: @c.Duration min</p>
                            <p class="text-success fw-semibold mt-2">
                                <i class="bi bi-cash-stack"></i> $@c.PricePerSession / session
                            </p>
                        </div>
                        <form asp-action="Unsubscribe" method="post" class="mt-2">
                            <input type="hidden" name="classId" value="@c.ClassID" />
                            <button type="submit" class="btn btn-outline-danger w-100">
                                <i class="bi bi-x-circle"></i> Cancel Enrollment
                            </button>
                        </form>

                    </div>
                </div>
            }
        </div>
    }
</div>
