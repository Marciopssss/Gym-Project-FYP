@model IEnumerable<Gym_Membership.Models.Notification>

<h2 class="text-info fw-bold mb-4"><i class="bi bi-bell"></i> Notifications</h2>

@if (!Model.Any())
{
    <p class="text-secondary">You have no notifications.</p>
}
else
{
    <ul class="list-group shadow-sm">
        @foreach (var note in Model)
        {
            <li class="list-group-item bg-dark text-light d-flex justify-content-between align-items-center">
                <span>@note.Message</span>
                <small class="text-muted">@note.DateSent.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</small>
            </li>
        }
    </ul>
}
