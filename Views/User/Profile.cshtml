@model Gym_Membership.Models.User

@{
    ViewData["Title"] = "My Profile";
}

<h2 class="mb-4">My Profile</h2>

<div class="card bg-dark text-light p-4 shadow-lg">
    <p><strong>Username:</strong> @Model.Username</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Phone:</strong> @(Model.Phone ?? "Not provided")</p>
    <p><strong>Address:</strong> @(Model.Address ?? "Not provided")</p>
    <p><strong>Age:</strong> @(Model.Age ?? 0)</p>
    <p><strong>Gender:</strong> @(Model.Gender ?? "Not specified")</p>

    <a asp-action="EditProfile" class="btn btn-primary mt-3">Edit My Information</a>
</div>


