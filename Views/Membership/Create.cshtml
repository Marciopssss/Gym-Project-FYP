@model Gym_Membership.Models.Membership

<form asp-action="Create" asp-controller="Membership" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <!-- Type (string) -->
    <div class="mb-3">
        <label asp-for="Type" class="form-label text-light"></label>
        <select asp-for="Type" class="form-select bg-dark text-light border-secondary" required>
            <option value="">-- Select Membership Type --</option>
            <option value="Basic">Basic</option>
            <option value="Premium">Premium</option>
            <option value="Student">Student</option>
            <option value="VIP">VIP</option>
        </select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    <!-- Duration (int) -->
    <div class="mb-3">
        <label asp-for="Duration" class="form-label text-light"></label>
        <select asp-for="Duration" class="form-select bg-dark text-light border-secondary" required>
            <option value="">-- Select Duration --</option>
            <option value="1">1 Month</option>
            <option value="3">3 Months</option>
            <option value="6">6 Months</option>
            <option value="12">12 Months</option>
        </select>
        <span asp-validation-for="Duration" class="text-danger"></span>
    </div>

    <!-- Price (decimal) -->
    <div class="mb-3">
        <label asp-for="Price" class="form-label text-light"></label>
        <select asp-for="Price" class="form-select bg-dark text-light border-secondary" required>
            <option value="">-- Select Price --</option>
            <option value="20.00">20$</option>
            <option value="50.00">50$</option>
            <option value="90.00">90$</option>
            <option value="150.00">150$</option>
        </select>
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-between">
        <button type="submit" class="btn btn-success w-50 me-2">Save</button>
        <a asp-action="Index" class="btn btn-secondary w-50">Cancel</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
