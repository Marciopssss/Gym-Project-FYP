@model IEnumerable<Gym_Membership.Models.Membership>
@{
    ViewData["Title"] = "Membership Plans";
}

<h2 class="text-center mb-4">Available Membership Plans</h2>

<div class="container">
    <div class="row justify-content-center">
        @foreach (var plan in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm border-0">

                    
                    @{
                        string imagePath = plan.Type.ToLower() switch
                        {
                            "basic" => "/images/memberships/basic.jpg",
                            "premium" => "/images/memberships/premium.jpg",
                            "student" => "/images/memberships/student.jpg",
                            _ => "/images/memberships/default.jpg" 
                        };
                    }

                    <img src="@imagePath"
                         class="card-img-top"
                         alt="@plan.Type Plan"
                         style="height: 220px; object-fit: cover; border-top-left-radius: 12px; border-top-right-radius: 12px;" />

                    <div class="card-body text-center">
                        <h4 class="card-title text-primary">@plan.Type</h4>
                        <p class="card-text mb-2"><strong>Duration:</strong> @plan.Duration month(s)</p>
                        <p class="card-text mb-2"><strong>Price:</strong> $@plan.Price</p>

                        @if (!string.IsNullOrEmpty(plan.description))
                        {
                            <p class="card-text text-muted small">@plan.description</p>
                        }

                        <form asp-controller="Subscription" asp-action="Subscribe" method="post">
                            <input type="hidden" name="membershipId" value="@plan.MembershipID" />
                            <button type="submit" class="btn btn-success w-100 mt-2">Subscribe</button>
                        </form>

                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
