@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

@{
    var username = HttpContextAccessor.HttpContext.Session.GetString("Username");
    var role = HttpContextAccessor.HttpContext.Session.GetString("Role");
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gym Membership</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://js.stripe.com/v3/"></script>


    <!-- ✅ Then your CSS (must be last to override Bootstrap) -->
    <link href="~/css/style.css" rel="stylesheet" />
</head>
<body class="bg-dark text-light">
    <header class="border-bottom border-secondary">
        <nav class="navbar navbar-expand-lg navbar-dark container py-2">
            <a class="navbar-brand fw-bold neon" asp-controller="Home" asp-action="Index">
                Fitness<span class="neon-accent"> Gym</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav ms-auto gap-2 align-items-center">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    @if (role == "Admin")
                    {
                        <!-- 🔹 Admin Navigation -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Membership" asp-action="Index">Manage Memberships</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Classes" asp-action="Index">Manage Classes</a>
                        </li>
                    }
                    else
                    {
                        <!-- 🔹 User Navigation -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Membership" asp-action="Plans">Memberships</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Classes" asp-action="Browse">Browse Classes</a>
                        </li>
                    }


                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Trainer" asp-action="Browse">Trainers</a>
                    </li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>

                    @if (string.IsNullOrEmpty(username))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#">Account</a>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Auth" asp-action="Login">Login</a></li>
                                <li><a class="dropdown-item" asp-controller="Auth" asp-action="Register">Register</a></li>
                            </ul>
                        </li>
                    }
                    else if (role == "Admin")
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-warning" data-bs-toggle="dropdown" href="#">
                                @username
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="TrainerApplication" asp-action="AdminView">Trainer Applications</a></li>
                                <li><hr class="dropdown-divider" /></li>

                                <li><a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">Logout</a></li>
                            </ul>
                        </li>
                    }
                    else if (role == "Trainer")
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-info" data-bs-toggle="dropdown" href="#">
                                @username
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Trainer" asp-action="Profile">
                                        Trainer Profile
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="User" asp-action="Profile">My Profile</a></li>
                                <li><hr class="dropdown-divider" /></li>

                                <li><a class="dropdown-item" asp-controller="User" asp-action="MyClasses">My Classes</a></li>

                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">
                                        Logout
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-info" data-bs-toggle="dropdown" href="#">
                                @username
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="User" asp-action="Profile">My Profile</a></li>
                                <li><hr class="dropdown-divider" /></li>

                                <li><a class="dropdown-item" asp-controller="User" asp-action="MyClasses">My Classes</a></li>

                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="TrainerApplication" asp-action="Apply">Become a Trainer</a></li>
                                <li><hr class="dropdown-divider" /></li>

                                <li><a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">Logout</a></li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <!-- ✅ THIS IS THE CRITICAL LINE -->
    <main class="container my-4">
        @RenderBody()
        @inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

        @{
            var trainerMsg = HttpContextAccessor.HttpContext.Session.GetString("TrainerNotification");
        }

        @if (!string.IsNullOrEmpty(trainerMsg))
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @trainerMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

    </main>

    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();
    }

    @if (controller == "Home" && action == "Index")
    {
        <footer class="bg-dark border-top border-secondary mt-5 pt-5 text-light">
            <div class="container">
                <div class="row g-4">

                    <!-- 🌟 Column 1: About -->
                    <div class="col-md-4">
                        <h5 class="fw-bold text-info mb-3">About Fitness Gym</h5>
                        <p class="text-secondary">
                            Fitness Gym is your all-in-one platform to manage memberships, book classes, and track your fitness journey.
                            We combine smart technology with expert trainers to help you reach your goals.
                        </p>
                        <div class="d-flex gap-3 mt-3">
                            <a href="#" class="text-info fs-4"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="text-info fs-4"><i class="bi bi-instagram"></i></a>
                            <a href="#" class="text-info fs-4"><i class="bi bi-youtube"></i></a>
                        </div>
                    </div>

                    <!-- 🌟 Column 2: Quick Links -->
                    <div class="col-md-4">
                        <h5 class="fw-bold text-info mb-3">Quick Links</h5>
                        <ul class="list-unstyled">
                            <li><a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none">🏠 Home</a></li>
                            <li><a asp-controller="Membership" asp-action="Plans" class="text-secondary text-decoration-none">💪 Membership Plans</a></li>
                            <li><a asp-controller="Classes" asp-action="Browse" class="text-secondary text-decoration-none">🗓️ Browse Classes</a></li>
                            <li><a asp-controller="Employees" asp-action="Index" class="text-secondary text-decoration-none">🏋️ Trainers</a></li>
                            <li class="nav-item">
                                <a asp-controller="Contact" asp-action="Index" class="nav-link">Contact Us</a>
                            </li>
                        </ul>
                    </div>

                    <!-- 🌟 Column 3: Send a Message -->
                    <div class="col-md-4">
                        <h5 class="fw-bold text-info mb-3">Send a Message</h5>
                        <form asp-controller="Home" asp-action="SendMessage" method="post">
                            <div class="mb-2">
                                <input type="text" name="Name" class="form-control bg-dark text-light border-secondary" placeholder="Your Name" required />
                            </div>
                            <div class="mb-2">
                                <input type="email" name="Email" class="form-control bg-dark text-light border-secondary" placeholder="Your Email" required />
                            </div>
                            <div class="mb-2">
                                <textarea name="Message" class="form-control bg-dark text-light border-secondary" rows="3" placeholder="Your Message" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-info w-100 mt-2">
                                <i class="bi bi-send-fill me-2"></i> Send
                            </button>
                        </form>
                    </div>

                </div>

                <!-- 🌟 Bottom Bar -->
                <div class="text-center border-top border-secondary mt-4 pt-3 small text-secondary">
                    <p class="mb-0">
                        © @DateTime.Now.Year Fitness Gym | Developed by <span class="text-info">Ralph Touma</span> |
                        <a asp-controller="Home" asp-action="Privacy" class="link-secondary">Privacy Policy</a>
                    </p>
                </div>
            </div>
        </footer>
    }



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/script.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
