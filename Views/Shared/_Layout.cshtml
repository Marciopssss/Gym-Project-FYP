@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

@{
    var username = HttpContextAccessor.HttpContext.Session.GetString("Username");
    var role = HttpContextAccessor.HttpContext.Session.GetString("Role");
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gym Membership</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- ✅ Then your CSS (must be last to override Bootstrap) -->
    <link href="~/css/style.css" rel="stylesheet" />
</head>
<body class="bg-dark text-light">
    <header class="border-bottom border-secondary">
        <nav class="navbar navbar-expand-lg navbar-dark container py-2">
            <a class="navbar-brand fw-bold neon" asp-controller="Home" asp-action="Index">
                Gym<span class="neon-accent">_Membership</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav ms-auto gap-2 align-items-center">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Membership" asp-action="Index">Memberships</a>
                    </li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Classes" asp-action="Index">Classes</a></li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Classes" asp-action="Browse">Browse Classes</a>
                    </li>

                    <li class="nav-item"><a class="nav-link" asp-controller="Employees" asp-action="Index">Trainers</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>

                    @if (string.IsNullOrEmpty(username))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#">Account</a>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Auth" asp-action="Login">Login</a></li>
                                <li><a class="dropdown-item" asp-controller="Auth" asp-action="Register">Register</a></li>
                            </ul>
                        </li>
                    }
                    else if (role == "Admin")
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-warning" data-bs-toggle="dropdown" href="#">
                                @username
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">Logout</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-info" data-bs-toggle="dropdown" href="#">
                                @username
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="User" asp-action="Profile">My Profile</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">Logout</a></li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <!-- ✅ THIS IS THE CRITICAL LINE -->
    <main class="container my-4">
        @RenderBody()
    </main>

    <footer class="border-top border-secondary py-4 mt-5">
        <div class="container small text-secondary d-flex justify-content-between">
            <span>© @DateTime.Now.Year - Gym_Membership</span>
            <a class="link-secondary" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/script.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
