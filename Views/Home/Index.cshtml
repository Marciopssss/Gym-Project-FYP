@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Home";
    var username = HttpContextAccessor.HttpContext.Session.GetString("Username");
}

<!-- ===== HERO SECTION ===== -->
<section class="hero-section text-center py-5 bg-dark text-light">
    <div class="container">
        @if (TempData["Success"] != null)
{
    <div class="alert alert-success text-center shadow-sm rounded-4 p-3 mb-4">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
    </div>
}

        <!-- Title -->
        <h1 class="display-4 fw-bold mb-3 text-glow">
            Transform your body.<br />Track your progress.
        </h1>

        <!-- Subtitle -->
        <p class="lead mt-3 text-secondary fs-5">
            Manage members, classes, and payments — all in one place.
        </p>

        <!-- Buttons -->
        <div class="mt-4 d-flex justify-content-center gap-3 flex-wrap">
            @if (username != null)
            {
                <!-- ✅ Logged-in user -->
                <a asp-controller="Membership" asp-action="Plans" class="btn btn-neon-primary btn-lg px-4 py-2">
                    <i class="bi bi-person-lines-fill me-2"></i> View Plans
                </a>
                <a asp-controller="Classes" asp-action="Browse" class="btn btn-outline-neon btn-lg px-4 py-2">
                  <i class="bi bi-calendar-check me-2"></i> Browse Classes
                </a>

            }
            else
            {
                <!-- ❌ Not logged in — show modal -->
                <button class="btn btn-neon-primary btn-lg px-4 py-2" data-bs-toggle="modal" data-bs-target="#loginPromptModal">
                    <i class="bi bi-person-lines-fill me-2"></i> View Plans
                </button>
                <button class="btn btn-outline-neon btn-lg px-4 py-2" data-bs-toggle="modal" data-bs-target="#loginPromptModal">
                    <i class="bi bi-calendar-check me-2"></i> Browse Classes
                </button>
            }
        </div>

        <!-- Stats -->
        <div class="mt-5 row justify-content-center">
            <div class="col-md-8">
                <div class="bg-dark border border-secondary rounded-4 p-4 shadow-sm text-light">
                    <div class="row text-center">
                        <div class="col-md-4 border-end border-secondary">
                            <h3 class="fw-bold mb-0 text-info">120+</h3>
                            <p class="text-secondary mb-0">Active Members</p>
                        </div>
                        <div class="col-md-4 border-end border-secondary">
                            <h3 class="fw-bold mb-0 text-info">18</h3>
                            <p class="text-secondary mb-0">Weekly Classes</p>
                        </div>
                        <div class="col-md-4">
                            <h3 class="fw-bold mb-0 text-info">9.2</h3>
                            <p class="text-secondary mb-0">Avg Rating</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@if (ViewBag.ActiveSubscription != null)
{
    var sub = ViewBag.ActiveSubscription;
    <div class="container mt-4">
        <div class="subscription-card p-4 rounded-4 shadow-lg text-center text-light">
            <h5 class="fw-bold mb-3 text-neon-green">
                <i class="bi bi-lightning-charge-fill me-2"></i>
                Active Plan: @sub.Membership.Type
            </h5>

            <div class="d-flex justify-content-center flex-column align-items-center">
                <p class="mb-1 start-date">
                    <strong>Start Date:</strong> @sub.StartDate.ToString("MMMM dd, yyyy")
                </p>
                <p class="mb-0 end-date">
                    <strong>Expires On:</strong> @sub.EndDate.ToString("MMMM dd, yyyy")
                </p>
            </div>
        </div>
    </div>
}



<!-- ===== MODERN FEATURES SECTION ===== -->
<section class="py-5 mt-5 bg-gradient-dark text-light">
    <div class="container text-center">
        <h2 class="fw-bold display-6 mb-3 text-uppercase text-info">
            Your Fitness Journey Starts Here
        </h2>
        <p class="text-secondary mb-5 fs-5">
            Explore a smarter, cleaner gym experience — track progress, get personalized guidance, and stay consistent.
        </p>

        <div class="row g-4 justify-content-center">
            <!-- Card 1 -->
            <div class="col-md-4">
                <div class="card feature-card border-0 bg-dark text-light shadow-lg h-100">
                    <div class="card-body text-center p-4">
                        <div class="icon-circle bg-danger bg-opacity-25 mb-3 mx-auto">
                            <i class="bi bi-activity text-danger fs-1"></i>
                        </div>
                        <h5 class="fw-bold mb-2">Performance Tracking</h5>
                        <p class="text-muted">
                            Monitor your progress and achievements — stay motivated every step of the way.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="col-md-4">
                <div class="card feature-card border-0 bg-dark text-light shadow-lg h-100">
                    <div class="card-body text-center p-4">
                        <div class="icon-circle bg-success bg-opacity-25 mb-3 mx-auto">
                            <i class="bi bi-clipboard2-check text-success fs-1"></i>
                        </div>
                        <h5 class="fw-bold mb-2">Custom Workout Plans</h5>
                        <p class="text-muted">
                            Access personalized programs tailored to your goals and skill level.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="col-md-4">
                <div class="card feature-card border-0 bg-dark text-light shadow-lg h-100">
                    <div class="card-body text-center p-4">
                        <div class="icon-circle bg-info bg-opacity-25 mb-3 mx-auto">
                            <i class="bi bi-heart-pulse text-info fs-1"></i>
                        </div>
                        <h5 class="fw-bold mb-2">Health & Nutrition</h5>
                        <p class="text-muted">
                            Get guidance on diet, wellness, and recovery to maximize your performance.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== LOGIN PROMPT MODAL ===== -->
<div class="modal fade" id="loginPromptModal" tabindex="-1" aria-labelledby="loginPromptLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border border-info shadow-lg">
            <div class="modal-header border-0">
                <h5 class="modal-title text-info fw-bold" id="loginPromptLabel">
                    Login Required
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <p class="mb-4 fs-5">You need to log in or sign up to access this section.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-info px-4">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Log In
                    </a>
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-info px-4">
                        <i class="bi bi-person-plus me-2"></i> Sign Up
                    </a>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
