@model Gym_Membership.Models.User
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4 card-glow shadow-lg">
            <h3 class="mb-3 text-center">Welcome back</h3>

            <form asp-action="Login" asp-controller="Auth" method="post">
                <div class="mb-3">
                    <label asp-for="Username" class="form-label">Username</label>
                    <input asp-for="Username" class="form-control" placeholder="Enter your username" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                </div>

                <button type="submit" class="btn btn-primary w-100">Login</button>

                <div class="text-center mt-3">
                    <span class="text-secondary">Don't have an account?</span>
                    <a asp-controller="Auth" asp-action="Register" class="text-light ms-1">Sign Up</a>
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3">@ViewBag.Error</div>
            }
        </div>
    </div>
</div>
<div class="mt-3 text-center">
    <a class="btn btn-outline-danger" asp-controller="Auth" asp-action="GoogleLogin">
        <i class="bi bi-google"></i> Sign in with Google
    </a>
</div>