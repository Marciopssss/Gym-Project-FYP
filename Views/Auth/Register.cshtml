@model Gym_Membership.Models.User
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4 card-glow shadow-lg">
            <h3 class="mb-3 text-center">Create your account</h3>

            <form asp-action="Register" asp-controller="Auth" method="post">
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full Name</label>
                    <input asp-for="FullName" class="form-control" placeholder="John Doe" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label">Username</label>
                    <input asp-for="Username" class="form-control" placeholder="Choose a username" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                </div>

                <button type="submit" class="btn btn-primary w-100">Create Account</button>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3">@ViewBag.Error</div>
            }

            <p class="text-secondary small mt-3 mb-0 text-center">
                Already have an account?
                <a asp-controller="Auth" asp-action="Login" class="text-light">Login here</a>
            </p>
        </div>
    </div>
</div>

<div class="text-center mt-3 text-secondary">or</div>

<a class="btn btn-outline-light w-100 mt-2 d-flex align-items-center justify-content-center gap-2"
   asp-controller="Auth" asp-action="GoogleLogin">
    <img src="https://www.svgrepo.com/show/475656/google-color.svg" width="20" height="20" alt="">
    Sign up with Google
</a>
