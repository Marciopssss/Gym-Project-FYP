@model Gym_Membership.Models.User
@{
    ViewData["Title"] = "Delete User";
}

<h2 class="text-center mb-4 text-danger">Delete User</h2>

<div class="card p-4 bg-dark text-light shadow-lg">
    <p>Are you sure you want to delete <strong>@Model.Username</strong>?</p>

    <form asp-action="Delete">
        <input type="hidden" asp-for="UserId" />
        <button type="submit" class="btn btn-danger w-100 mb-2">Delete</button>
        <a asp-action="Index" class="btn btn-secondary w-100">Cancel</a>
    </form>
</div>
