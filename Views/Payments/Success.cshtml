@{
    ViewData["Title"] = "Payment Successful";
}

<section class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 p-5">
                <h1 class="text-success mb-3">✅ Payment Successful</h1>
                <p class="lead">@ViewBag.Message ?? "Thank you — your membership is now active (demo)." </p>
                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">Go to Home</a>
                    <a asp-controller="Membership" asp-action="Plans" class="btn btn-outline-secondary">Back to Plans</a>
                </div>
            </div>
        </div>
    </div>
</section>

