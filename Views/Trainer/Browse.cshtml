@model IEnumerable<Gym_Membership.Models.ViewModels.TrainerCardViewModel>

@{
    ViewData["Title"] = "Personal Trainers";
}

<div class="container py-4 text-light">
    <h2 class="mb-4">Choose Your Personal Trainer</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <p>No trainers are available at the moment.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var t in Model)
            {
                <div class="col-md-4">
                    <div class="card bg-dark border-secondary h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-info">@t.Name</h5>

                            <p class="mb-1">
                                <strong>Price:</strong>
                                @(t.Price.HasValue ? $"{t.Price.Value:0.##} $" : "On request")
                            </p>

                            <p class="mb-3">
                                <strong>Schedule:</strong><br />
                                @(!string.IsNullOrWhiteSpace(t.Schedule) ? t.Schedule : "Flexible / to be agreed")
                            </p>

                            <form asp-controller="Trainer" asp-action="Choose" method="post" class="mt-auto">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="trainerUserId" value="@t.TrainerUserId" />
                                <button type="submit" class="btn btn-success w-100">
                                    Choose this trainer
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
