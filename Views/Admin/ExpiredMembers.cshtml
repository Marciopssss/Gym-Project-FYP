@model IEnumerable<Gym_Membership.Models.ExpiredMemberViewModel>

@{
    ViewBag.Title = "Expired Members Report";
}

<div class="container mt-4">
    <h2 class="text-warning mb-4">Expired Members Report</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-success text-center">
            🎉 No expired members found. All memberships are active!
        </div>
    }
    else
    {
        <table class="table table-dark table-striped table-bordered align-middle">
            <thead class="table-secondary text-dark">
                <tr>
                    <th>Member ID</th>
                    <th>Name</th>
                    <th>Membership Type</th>
                    <th>Expiry Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MemberID</td>
                        <td>@item.Name</td>
                        <td>@item.PlanName</td> @* or @item.Type if renamed *@
                        <td>@item.ExpiryDate.ToShortDateString()</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
