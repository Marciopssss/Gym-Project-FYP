@{
    ViewData["Title"] = "Expired Members";
}

<h2 class="text-warning mb-4 fw-bold">
    <i class="bi bi-exclamation-triangle"></i> Expired Memberships
</h2>

@if (ViewBag.Message != null)
{
    <div class="alert alert-success text-center">@ViewBag.Message</div>
}
else
{
    <table class="table table-dark table-striped table-hover align-middle text-center shadow-sm rounded-4">
        <thead class="table-warning text-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Plan</th>
                <th>Expired On</th>
                <th>Days Since Expiry</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in Model)
            {
                <tr>
                    <td>@member.CustomerID</td>
                    <td class="fw-semibold">@member.Name</td>
                    <td>@member.Email</td>
                    <td>@member.Plan</td>
                    <td>@member.ExpiryDate.ToString("MM/dd/yyyy")</td>
                    <td>
                        <span class="badge bg-danger">@member.DaysExpired days ago</span>
                    </td>
                    <td>
                        <form asp-action="SendReminder" asp-controller="Admin" method="post" style="display:inline;">
                            <input type="hidden" name="userId" value="@member.UserId" />
                            <button type="submit" class="btn btn-outline-info btn-sm">
                                <i class="bi bi-bell"></i> Send Reminder
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success text-center mt-4 shadow-sm">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
    </div>
}
